{
  "name": "@coms-console/quackbox-design-system",
  "version": "5.0.3",
  "description": "A UI Component library and design system for the RIT COMS QuackBox",
  "author": "Makenzie Dorsey <@m-dorsey> of RIT COMS <@rit-coms>",
  "license": "MIT",
  "homepage": "https://github.com/rit-coms/quackbox-design-system",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rit-coms/quackbox-design-system.git"
  },
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "ui components",
    "library",
    "react-components",
    "ui"
  ],
  "type": "module",
  "main": "dist/quackbox-design-system.umd.js",
  "module": "dist/your-design-system.es.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/quackbox-design-system.es.js",
      "require": "./dist/quackbox-design-system.umd.js"
    }
  },
  "files": [
    "dist",
    "types",
    "assets"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "catalog:",
    "react-dom": "catalog:",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "eslint-plugin-react": "^7.37.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.0.1",
    "@eslint/js": "^9.39.4",
    "@storybook/blocks": "^8.6.14",
    "@storybook/manager-api": "^8.6.14",
    "@storybook/react": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@storybook/test": "^8.6.15",
    "@storybook/theming": "^8.6.14",
    "@types/react": "^19.2.14",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "eslint-plugin-storybook": "^10.2.19",
    "globals": "^15.15.0",
    "postcss-nesting": "^13.0.2",
    "react-icons": "^5.6.0",
    "storybook": "^10.2.19",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^6.4.1",
    "vite-plugin-css-injected-by-js": "^3.5.2",
    "vite-plugin-dts": "^4.5.4",
    "@storybook/addon-docs": "^10.2.19"
  },
  "eslintConfig": {
    "extends": [
      "plugin:storybook/recommended"
    ]
